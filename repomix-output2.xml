def get_asset_config(asset_key: str) -> dict:

    if asset_key not in ASSET_CONFIGS:

        raise KeyError(

            f"Asset '{asset_key}' no está configurado en ASSET_CONFIGS. "

            f"Disponibles: {list(ASSET_CONFIGS.keys())}"

        )

    return ASSET_CONFIGS[asset_key]
